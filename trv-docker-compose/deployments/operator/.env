# Operator Node Deployment Environment
# These variables are specific to this deployment instance

# Docker Image Configuration
IMAGE=edgelake-mcp
TAG=amd64-latest

# Node Identity (from base_configs.env, can override here)
NODE_NAME=edgelake-operator

# You can override any config from base_configs.env or advance_configs.env here
# Example overrides:
OVERLAY_IP=100.102.221.116
# COMPANY_NAME="My Company"
# CLUSTER_NAME=my-cluster
