# Root-level configuration for trv-docker-compose
# Copy this to .env.root and customize for your environment
# These settings apply to the Makefile and can be overridden per deployment

# ====================
# DOCKER IMAGE DEFAULTS
# ====================
# Default image/tag used if not specified in deployment .env
DEFAULT_IMAGE=edgelake-mcp
DEFAULT_TAG=amd64-latest

# ====================
# DEFAULT DEPLOYMENT
# ====================
# Which deployment to use when no type is specified
DEFAULT_EDGELAKE_TYPE=query

# ====================
# SSH DEFAULTS
# ====================
# Default SSH user for connecting to remote hosts
# Override per deployment using OVERLAY_IP in configs
SSH_USER=tviviano

# ====================
# REGISTRY (if using private registry)
# ====================
# REGISTRY=100.127.19.27:5000
# REGISTRY_IMAGE=${REGISTRY}/${DEFAULT_IMAGE}:${DEFAULT_TAG}
